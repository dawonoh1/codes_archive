est_c1 = feols(visitor ~ distance+bus500no+sub500no+parkingcarno+plazaarea+roadarea+trailarea+greenarea+tot_sf_no+ campingarea+amusementno+sportsno+indoorspno+outdoorspno+communityno+stageno+restaurantno+cstoreno , data = dl)
etable(est_c0, est_c1, se = "cluster",                 # One way Clustered
cluster = c("ID"))
etable(est_c0, est_c1, se = "hetero")
