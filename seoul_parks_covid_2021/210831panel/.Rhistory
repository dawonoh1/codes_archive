xxx<-cbind(합계2034비율,합계3564비율, 합계총생활인구수, 비율2034상주인구, 비율3564상주인구, 총상주인구, 지하철역500미터, 버스정류장500미터, 사업체당.종사자수, 주거, 문화및집회, 위락, 숙박)
lum.OLS <-lm(Y ~ xxx, data = data1)
bptest(lum.OLS)
lum.PN.PL <- plm(Y ~xxx, data=pdata1, effect = "individual", model="pooling")
summary(lum.PN.PL)
lum.PN.F <- plm(Y ~ xxx,data=pdata1, effect = "individual", model="within")
summary(lum.PN.F)
## time-fixed effects
lum.PN.FT <- plm(Y~ xxx, data=pdata1, effect = "time", model="within")
summary(lum.PN.FT)
## twoway-fixed effects
lum.PN.FTW <- plm(Y ~ xxx, data=pdata1, effect = "twoway", model="within")
summary(lum.PN.FTW)
## pFtest
pFtest(lum.PN.F, lum.OLS)
pFtest(lum.PN.FT, lum.OLS)
pFtest(lum.PN.FTW, lum.OLS)
##If the p-value is < 0.05 then the fixed effects model is a better choice
## pooling model = OLS model
lum.PN.PL <- plm(Y ~ xxx, data=pdata1, model="pooling")
summary(lum.PN.PL)
## Breusch-Pagan Lagranger-Multiplier test for panel effects
plmtest(lum.PN.PL, type=c("bp"))
### Random-effects
lum.PN.R <- plm(Y ~ xxx, data=pdata1, model="random", random.method = "walhus", random.dfcor = 3)
summary(lum.PN.R)
## phtest - comprison of the two models;one panel, the other pooling
phtest(lum.PN.F, lum.PN.R)
phtest(lum.PN.FT, lum.PN.R)
phtest(lum.PN.FTW, lum.PN.R)
## Breusch-Pagan Lagranger-Multiplier test for panel effects (heteroskedasticity)
plmtest(lum.PN.PL, type=c("bp"))
## Wald test (heteroskedasticity)
pwaldtest(lum.PN.F, test = "F")
## Autocorr test (Serial corr test)
pwartest(Y ~ xxx, data=pdata1)
## Autocorr test (Durbin-Watson Test)
pdwtest(Y ~ xxx, data=pdata1, effect = "time",  model="within")
pdwtest(Y ~ xxx, data=pdata1, effect = "twoway",  model="within")
pbsytest(Y ~ xxx, data=pdata1, test="j")
pbsytest(Y ~ xxx, data=pdata1)
pbsytest(Y ~ xxx, data=pdata1, test="re")
## Autocorr test (Serial corr test)
fixed <- plm(Y ~xxx, data=pdata1, index=c("OD", "STD_YMD"), model="within")
pbgtest(fixed)
## cross-sectional dependence
fixed <- plm(Y ~ xxx, data=pdata1, index=c("상권", "분기"), model="within")
pcdtest(fixed, test = c("lm"))
pcdtest(fixed, test = c("cd"))
## Autocorr test (Serial corr test)
fixed <- plm(Y ~ xxx, data=pdata1, index=c("OD", "분기"), model="within")
pwartest(Y ~xxx, data=pdata1)
pbgtest(fixed)
## null hypothesis for the Breusch-Pagan test is homoskedasticity
library(lmtest)
bptest(Y ~ xxx + factor(상권), data = data1 , studentize=F)
