library(tidyverse) # Modern data science library
library(plm)       # Panel data analysis library
library(car)       # Companion to applied regression
library(gplots)    # Various programing tools for plotting data
library(tseries)   # For timeseries analysis
library(lmtest)    # For hetoroskedasticity analysis
library(xtable)
library(htest)
data <- read.csv("E:/Dropbox/Dropbox/학회3/투고준비/변수정리/변수정리222r.csv")
attach(data)
View(data)
Y <-cbind(LUM)
pdata <- pdata.frame(data, index=c("상권", "분기"))
pdim(pdata)
detach(data)
attach(data)
data1 <- read.csv("E:/Dropbox/Dropbox/학회3/투고준비/변수정리/변수정리222r.csv")
attach(data1)
View(data1)
Y <-cbind(LUM)
pdata <- pdata.frame(data1, index=c("상권", "분기"))
pdim(pdata1)
pdata1 <- pdata.frame(data1, index=c("상권", "분기"))
pdim(pdata1)
X<-cbind(주거, 숙박, 리테일, 서비스, 교육, 업무, 문화및집회, 스포츠, 운수, 의료, 위락, 합계2034비율, 합계3564비율, 비율2034상주인구, 비율3564상주인구,  ln버스정류장일일500미터, ln지하철역일일500미터, ln사업체수, ln종사자수, ln사업체당.종사자수)
lum.OLS <-lm(Y ~ X, data = pdata1)
summary(lum.OLS)
bptest(lum.OLS)
lum.PN.PL <- plm(Y ~ X, data=pdata1, effect = "individual", model="pooling")
summary(lum.PN.PL)
## within model
lum.PN.F <- plm(Y ~ X,data=pdata1, effect = "individual", model="within")
summary(lum.PN.F)
## time-fixed effects
lum.PN.FT <- plm(Y~ X, data=pdata1, effect = "time", model="within")
summary(lum.PN.FT)
## twoway-fixed effects
lum.PN.FTW <- plm(Y ~ X, data=pdata1, effect = "twoway", model="within")
summary(lum.PN.FTW)
## pFtest
pFtest(lum.PN.F, lum.OLS)
pFtest(lum.PN.FT, lum.OLS)
pFtest(lum.PN.FTW, lum.OLS)
## pooling model = OLS model
lum.PN.PL <- plm(Y ~ X, data=pdata1, model="pooling")
summary(lum.PN.PL)
## Breusch-Pagan Lagranger-Multiplier test for panel effects
plmtest(lum.PN.PL, type=c("bp"))
### Random-effects
lum.PN.R <- plm(Y ~ X, data=pdata1, model="random", random.method = "walhus", random.dfcor = 3)
summary(lum.PN.R)
## phtest - comprison of the two models;one panel, the other pooling
phtest(lum.PN.F, lum.PN.R)
phtest(lum.PN.FT, lum.PN.R)
phtest(lum.PN.FTW, lum.PN.R)
## Breusch-Pagan Lagranger-Multiplier test for panel effects (heteroskedasticity)
plmtest(lum.PN.PL, type=c("bp"))
## Wald test (heteroskedasticity)
pwaldtest(lum.PN.F, test = "F")
## Autocorr test (Serial corr test)
pwartest(Y ~X, data=pdata1)
## Autocorr test (Durbin-Watson Test)
pdwtest(Y ~ X, data=pdata1, effect = "time",  model="within")
pdwtest(Y ~ X, data=pdata1, effect = "twoway",  model="within")
pbsytest(Y ~ X, data=pdata1, test="j")
pbsytest(Y ~ X, data=pdata1)
pbsytest(Y ~ X, data=pdata1, test="re")
## Autocorr test (Serial corr test)
fixed <- plm(Y ~ X, data=pdata1, index=c("상권", "분기"), model="within")
pbgtest(fixed)
## cross-sectional dependence
fixed <- plm(Y ~ X, data=pdata1, index=c("상권", "분기"), model="within")
pcdtest(fixed, test = c("lm"))
pcdtest(fixed, test = c("cd"))
## Autocorr test (Serial corr test)
fixed <- plm(Y ~ X, data=pdata1, index=c("상권", "분기"), model="within")
pwartest(Y ~X, data=pdata1)
pbgtest(fixed)
## null hypothesis for the Breusch-Pagan test is homoskedasticity
library(lmtest)
bptest(Y ~X + factor(상권), data = data1 , studentize=F)
library(tseries)
Panel.set <- plm.data(data1, index = c("상권", "분기"))
adf.test(Panel.set$LUM, k=2)
