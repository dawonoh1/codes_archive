library(tidyverse) # Modern data science library
library(plm)       # Panel data analysis library
library(car)       # Companion to applied regression
library(gplots)    # Various programing tools for plotting data
library(tseries)   # For timeseries analysis
library(lmtest)    # For hetoroskedasticity analysis
library(xtable)
library(htest)
pdata22 <- pdata.frame(data, index=c("상권","분기"))
pdim(pdata22)
as.data.frame(data22)
pdata22 <- pdata.frame(data22, index=c("상권","분기"))
pdim(pdata22)
lum.OLS <-lm(Y ~ X, data = pdata)
summary(lum.OLS)
bptest(lum.OLS)
lum.OLS <-lm(Y ~ X, data = pdata22)
summary(lum.OLS)
bptest(lum.OLS)
## pooling
lum.PN.PL <- plm(Y ~ X, data=pdata22, effect = "individual", model="pooling")
summary(lum.PN.PL)
## within model
lum.PN.F <- plm(Y ~ X,data=pdata, effect = "individual", model="within")
summary(lum.PN.F)
## time-fixed effects
lum.PN.FT <- plm(Y~ X, data=pdata22, effect = "time", model="within")
summary(lum.PN.FT)
## twoway-fixed effects
lum.PN.FTW <- plm(Y ~ X, data=pdata22, effect = "twoway", model="within")
summary(lum.PN.FTW)
## within model
lum.PN.F <- plm(Y ~ X,data=pdata22, effect = "individual", model="within")
summary(lum.PN.F)
## time-fixed effects
lum.PN.FT <- plm(Y~ X, data=pdata22, effect = "time", model="within")
summary(lum.PN.FT)
## twoway-fixed effects
lum.PN.FTW <- plm(Y ~ X, data=pdata22, effect = "twoway", model="within")
summary(lum.PN.FTW)
## pFtest
pFtest(lum.PN.F, lum.OLS)
pFtest(lum.PN.FT, lum.OLS)
pFtest(lum.PN.FTW, lum.OLS)
##If the p-value is < 0.05 then the fixed effects model is a better choice
## pooling model = OLS model
lum.PN.PL <- plm(Y ~ X, data=pdata22, model="pooling")
summary(lum.PN.PL)
## Breusch-Pagan Lagranger-Multiplier test for panel effects
plmtest(lum.PN.PL, type=c("bp"))
### Random-effects
lum.PN.R <- plm(Y ~ X, data=pdata22, model="random", random.method = "walhus", random.dfcor = 3)
summary(lum.PN.R)
## phtest - comprison of the two models;one panel, the other pooling
phtest(lum.PN.F, lum.PN.R)
phtest(lum.PN.FT, lum.PN.R)
phtest(lum.PN.FTW, lum.PN.R)
## Breusch-Pagan Lagranger-Multiplier test for panel effects (heteroskedasticity)
plmtest(lum.PN.PL, type=c("bp"))
## Wald test (heteroskedasticity)
pwaldtest(lum.PN.F, test = "F")
## Autocorr test (Serial corr test)
pwartest(Y ~X, data=pdata22)
## Autocorr test (Durbin-Watson Test)
pdwtest(Y ~ X, data=pdata22, effect = "time",  model="within")
pdwtest(Y ~ X, data=pdata22, effect = "twoway",  model="within")
pbsytest(Y ~ X, data=pdata22, test="j")
pbsytest(Y ~ X, data=pdata22)
pbsytest(Y ~ X, data=pdata22, test="re")
