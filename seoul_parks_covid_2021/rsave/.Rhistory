X20 <- cbind(로그거리미터, 로그면적제곱미터, 주차대수,  버스100미터,  지하철100미터,  로그도로면적,  로그광장면적,  로그산책로면적, 로그식수대면적, 로그연못면적,  로그캠핑장면적,로그운동장면적, 그늘면적, 운동시설수,  놀이기구수)
M19<-lmer(Y19~X19+(1|공원)+(1|유입지),data=dt1)
M20<-lmer(Y20~X20+(1|공원)+(1|유입지),data=dt1)
summary(M19)
ranova(M19)
summary(M20)
ranova(M20)
M0<-lmer(로그방문자수19~로그거리미터+(1|공원)+(1|유입지),data=data1,REML=FALSE)
summary(M0)
summ(M0)
ranova(M0)
M0<-lmer(로그방문자수19~1+(1|공원),data=data1,REML=FALSE)
summary(M0)
summ(M0)
ranova(M0)
M1<-lmer(로그방문자수19~1+로그거리미터+로그면적제곱미터+로그산책로면적+(1+로그거리미터+로그면적제곱미터|공원),data=data1,REML=FALSE)
summary(M1)
summ(M1)
ranova(M1)
View(M20)
#Model 1A same as Model 1 except slope for sex is not treated as randomly varying
#intercepts and slopes for extraverion are modeled as correlated
M1A<-lmer(로그방문자수19 ~ 1+ 로그거리미터 + 로그면적제곱미터 + 로그산책로면적 +(1+로그거리미터|공원),data=data1,REML=FALSE)
summary(M1A)
summ(M1A,digits=4)
ranova(M1A)
M0<-lmer(로그방문자수19~1+(1|유입지),data=data1,REML=FALSE)
summary(M0)
summ(M0)
ranova(M0)
M1<-lmer(로그방문자수19~1+로그거리미터+로그면적제곱미터+로그산책로면적+(1+로그거리미터+로그면적제곱미터|유입지),data=data1,REML=FALSE)
