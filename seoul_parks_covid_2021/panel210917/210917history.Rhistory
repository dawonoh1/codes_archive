pdim(pdata)
data <- read.csv("E:/Dropbox/Dropbox/학회3/투고준비/변수정리/final_dataset.csv")
data <- read.csv("E:/Dropbox/Dropbox/학회3/투고준비/변수정리/final_dataset.csv")
View(data)
attach(data)
pdata <- pdata.frame(data, index=c("상권","분기"))
pdim(pdata)
summary(X)
summary(Y)
Y <-cbind(LUM)
summary(Y)
plotmeans(LUM~분기, data = pdata)
X<-cbind(합계2034비율,합계3564비율, 총합계1000, 비율2034상주인구, 비율3564상주인구, 상주인구1000 ,버스500미터mill , 지하철500미터mill ,사업체수,종사자수, 사업체당.종사자수, 주거,숙박,리테일,서비스,교육,업무,문화및집회,스포츠,운수,의료,위락)
X<-cbind(비율합계2034청년인구수,비율합계3564중년인구수, 합계총생활인구수1000, 비율2034상주인구, 비율3564상주인구, 총상주인구1000 ,버스5정류장00미터mill , 지하철역500미터mill ,사업체수,종사자수, 사업체당.종사자수, 주거,숙박,리테일,서비스,교육,업무,문화및집회,스포츠,운수,의료,위락)
X<-cbind(비율합계2034청년인구수,비율합계3564중년인구수, 합계총생활인구수1000, 비율2034상주인구, 비율3564상주인구, 총상주인구1000 ,버스정류장500미터mill , 지하철역500미터mill ,사업체수,종사자수, 사업체당.종사자수, 주거,숙박,리테일,서비스,교육,업무,문화및집회,스포츠,운수,의료,위락)
X<-cbind(비율합계2034청년인구수,비율합계3564중년인구수, 합계총생활인구수1000, 비율2034상주인구, 비율3564상주인구, 총상주인구1000 ,버스정류장500미터mill , 지하철역500미터mill ,사업체수,종사자수, 사업체당종사자수, 주거,숙박,리테일,서비스,교육,업무,문화및집회,스포츠,운수,의료,위락)
summary(X)
pooling<- plm(Y~X, data=pdata, model = 'pooling')
summary(pooling)
firstdiff<- plm(Y~X, data=pdata, model = 'fd')
summary(firstdiff)
between<- plm(Y~X, data=pdata, model = 'between')
summary(between)
fixed<- plm(Y~X, data=pdata, model = 'within')
summary(fixed)
random<- plm(Y~X, data=pdata, model = 'random')
summary(random)
plmtest(pooling)
pFtest(fixed, pooling)
phtest(random, fixed)
## pooling
lum.PN.PL <- plm(Y ~ X, data=pdata, effect = "individual", model="pooling")
summary(lum.PN.PL)
## within model
lum.PN.F <- plm(Y ~ X,data=pdata, effect = "individual", model="within")
summary(lum.PN.F)
## time-fixed effects
lum.PN.FT <- plm(Y~ X, data=pdata, effect = "time", model="within")
summary(lum.PN.FT)
## twoway-fixed effects
lum.PN.FTW <- plm(Y ~ X, data=pdata, effect = "twoway", model="within")
summary(lum.PN.FTW)
## pFtest
pFtest(lum.PN.F, lum.OLS)
pFtest(lum.PN.FT, lum.OLS)
pFtest(lum.PN.FTW, lum.OLS)
##If the p-value is < 0.05 then the fixed effects model is a better choice
## pooling model = OLS model
lum.PN.PL <- plm(Y ~ X, data=pdata, model="pooling")
summary(lum.PN.PL)
## Breusch-Pagan Lagranger-Multiplier test for panel effects
plmtest(lum.PN.PL, type=c("bp"))
### Random-effects
lum.PN.R <- plm(Y ~ X, data=pdata, model="random", random.method = "walhus", random.dfcor = 3)
summary(lum.PN.R)
## phtest - comprison of the two models;one panel, the other pooling
phtest(lum.PN.F, lum.PN.R)
phtest(lum.PN.FT, lum.PN.R)
phtest(lum.PN.FTW, lum.PN.R)
## Breusch-Pagan Lagranger-Multiplier test for panel effects (heteroskedasticity)
plmtest(lum.PN.PL, type=c("bp"))
## Wald test (heteroskedasticity)
pwaldtest(lum.PN.F, test = "F")
## Autocorr test (Serial corr test)
pwartest(Y ~X, data=pdata)
## Autocorr test (Durbin-Watson Test)
pdwtest(Y ~ X, data=pdata, effect = "time",  model="within")
pdwtest(Y ~ X, data=pdata, effect = "twoway",  model="within")
pbsytest(Y ~ X, data=pdata, test="j")
pbsytest(Y ~ X, data=pdata)
pbsytest(Y ~ X, data=pdata, test="re")
lum.OLS <-lm(Y ~ X, data = pdata)
summary(lum.OLS)
bptest(lum.OLS)
## pFtest
pFtest(lum.PN.F, lum.OLS)
pFtest(lum.PN.FT, lum.OLS)
pFtest(lum.PN.FTW, lum.OLS)
##If the p-value is < 0.05 then the fixed effects model is a better choice
## Autocorr test (Serial corr test)
fixed <- plm(Y ~ X, data=pdata, index=c("상권", "분기"), model="within")
pbgtest(fixed)
## cross-sectional dependence
fixed <- plm(Y ~ X, data=pdata, index=c("상권", "분기"), model="within")
pcdtest(fixed, test = c("lm"))
pcdtest(fixed, test = c("cd"))
## Autocorr test (Serial corr test)
fixed <- plm(Y ~ X, data=pdata, index=c("상권", "분기"), model="within")
pwartest(Y ~X, data=pdata)
pbgtest(fixed)
## null hypothesis for the Breusch-Pagan test is homoskedasticity
library(lmtest)
bptest(Y ~X + factor(상권), data = data , studentize=F)
library(tseries)
