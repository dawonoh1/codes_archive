# Loading the required packages
library(foreign)
library(nnet)
library(stargazer)
# Getting the data
mydata = read.csv("E://Dropbox//Dropbox//covid//acsp//data//var_211009.csv")
mydata<-attach(mydata)
View(mydata)
mydata
table(mydata$cluster)
mydata$cluster2 = relevel(mydata$cluster, ref = "1")
multi1 = multinom(cluster2 ~ AREA + BUS_100 + SUB_500+PARKING+조경시설+휴식시설+어린이시설+운동시설+LOOK/AREA*10000+REST/AREA*10000+CHILD/AREA*10000+EXER/AREA*10000+PARKING+녹지율
, , data=mydata)
# Running the multinomial logit model using the multinom() function
multi1 = multinom(cluster ~ AREA + BUS_100 + SUB_500+PARKING+조경시설+휴식시설+어린이시설+운동시설+LOOK/AREA*10000+REST/AREA*10000+CHILD/AREA*10000+EXER/AREA*10000+PARKING+녹지율
, , data=mydata)
multi1 = multinom(cluster ~ AREA + BUS_100 + SUB_500+PARKING+조경시설+휴식시설+어린이시설+운동시설
+LOOK/AREA*10000+REST/AREA*10000+CHILD/AREA*10000+EXER/AREA*10000
+PARKING+녹지율, data=mydata)
multi1 = multinom(cluster ~ AREA + BUS_100 + SUB_500+PARKING
+조경시설+휴식시설+어린이시설+운동시설
+PARKING+녹지율, data=mydata)
library(stargazer)
stargazer(multi1, type="html", out="multi1.htm")
summary(multi1)
stargazer(multi1, type="html", out="multi1.htm")
stargazer(multi1, type="text", out="multi1.htm")
# Relative risk ratios allow an easier interpretation of the logit coefficients.
# They are the exponentiated value of the logit coefficients.
multi1.rrr = exp(coef(multi1))
multi1.rrr
stargazer(multi1, type="text", coef=list(multi1.rrr), p.auto=FALSE, out="multi1rrr.htm")
mydata = read.csv("E://Dropbox//Dropbox//covid//acsp//data//var_211009.csv")
mydata<-attach(mydata)
View(mydata)
#Checking the output (dependent) variable
table(mydata$cluster)
mydata$cluster2 = relevel(mydata$cluster, ref = "cluster1")
mydata = relevel(factor(cluster), ref="cluster1")
multi1 = multinom(cluster ~ AREA + BUS_100 + SUB_500+PARKING
+조경시설+휴식시설+어린이시설+운동시설
+PARKING+녹지율, data=mydata)
summary(multi1)
mydata = relevel(factor(cluster), ref="cluster2")
multi1 = multinom(cluster ~ AREA + BUS_100 + SUB_500+PARKING
+조경시설+휴식시설+어린이시설+운동시설
+PARKING+녹지율, data=mydata)
summary(multi1)
multinom <- within(multinom, mydata <- relevel(mydata, ref = cluster2))
multinom <- within(multinom, mydata <- relevel(mydata, ref = "cluster2"))
class(mydata)
levels(mydata$cluster)
savehistory("E:/rdata/mlogit/history211011.Rhistory")
